# ============================================================================
# HealthForecast AI - Environment Template
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ============================================================================

# ---------- Application ----------
APP_NAME=HealthForecastAI
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---------- Security / JWT ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ---------- PostgreSQL (structured clinical + user data) ----------
# For Render production, DATABASE_URL is auto-configured from the managed PostgreSQL
# For local development, use: postgresql+psycopg://postgres:postgres@localhost:healthforecast
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthforecast
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/healthforecast

# ---------- MongoDB (unstructured notes, model runs, audit trail) ----------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=healthforecast

# ---------- CORS ----------
# For production, update with your Cloudflare/Render frontend URL
# Format: comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- ML / AI Model ----------
# Model artifacts are not committed to git (see scripts/ci/check_files.py)
# For production, set MODEL_ARTIFACT_URL to download from GitHub Releases or CDN
MODEL_ARTIFACT_DIR=ml/artifacts
ACTIVE_RISK_MODEL=readmission_xgboost_v1
RISK_THRESHOLD_HIGH=0.20
RISK_THRESHOLD_MEDIUM=0.12

# ---------- Frontend (must be prefixed NEXT_PUBLIC_ or VITE_ to reach the browser) ----------
VITE_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=HealthForecast AI
