# ============================================================================
# HealthForecast AI - Environment Template
# Copy to .env and fill in real values. NEVER commit the real .env file.
# ============================================================================

# ---------- Application ----------
APP_NAME=HealthForecastAI
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ---------- Security / JWT ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ---------- PostgreSQL (structured clinical + user data) ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthforecast
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/healthforecast

# ---------- MongoDB (unstructured notes, model runs, audit trail) ----------
MONGO_URI=mongodb://localhost:27017
MONGO_DB=healthforecast

# ---------- CORS ----------
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------- ML ----------
MODEL_ARTIFACT_DIR=ml/artifacts
ACTIVE_RISK_MODEL=readmission_xgboost_v1
RISK_THRESHOLD_HIGH=0.20
RISK_THRESHOLD_MEDIUM=0.12

# ---------- Frontend (must be prefixed NEXT_PUBLIC_ to reach the browser) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=HealthForecast AI
