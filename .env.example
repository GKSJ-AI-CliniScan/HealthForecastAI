# ============================================================================
# HealthForecast AI - Production Environment Template
# Copy to .env for local development. NEVER commit a real .env file.
# In production, set these variables directly in the Render and Vercel dashboards.
# ============================================================================

# ---------- Application ----------
APP_NAME=HealthForecastAI
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ---------- Security & JWT Authentication ----------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-do-not-use-in-production
JWT_SECRET_KEY=change-me-do-not-use-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ---------- Database (Neon PostgreSQL in Production) ----------
# Production (Neon with SSL):
# DATABASE_URL=postgresql+psycopg://<username>:<password>@<neon-hostname>/<dbname>?sslmode=require
# Local Docker development:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/healthforecast
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthforecast
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------- CORS Configuration ----------
# Local development:
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production (set to your Vercel deployment URL):
FRONTEND_URL=https://healthforecast-ai.vercel.app

# ---------- ML & Model Artifacts ----------
MODEL_ARTIFACT_DIR=app/ml/models/saved
ACTIVE_RISK_MODEL=readmission_model_v1
RISK_THRESHOLD_HIGH=0.70
RISK_THRESHOLD_MEDIUM=0.40
DATASET_PATH=dataset/raw/diabetic_data.csv

# ---------- Frontend (Vercel) ----------
# In Vercel Project Settings > Environment Variables:
# VITE_API_BASE_URL=https://healthforecast-api.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1
