# Copy to .env.local (local dev) or set as build-time env/args (Docker, Render, Vercel).
# NEXT_PUBLIC_* values are baked into the JavaScript at BUILD time — rebuild after changing them.

# Backend base URL, including /api/v1.
#   local:    http://localhost:8000/api/v1
#   deployed: https://healthforecast-backend-i8kb.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# live (default) = real backend only, honest empty/error states.
# demo           = team sample data with a visible "sample data" banner (presentations only).
NEXT_PUBLIC_DATA_MODE=live
