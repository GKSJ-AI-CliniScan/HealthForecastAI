r enforces, so the two\ncan never disagree about what a role may do.","operationId":"read_me_api_v1_auth_me_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"object","title":"Response Read Me Api V1 Auth Me Get"}}}}},"security":[{"HTTPBearer":[]}]}},"/api/v1/auth/roles":{"get":{"tags":["Authentication"],"summary":"List the roles supported by the platform","description":"Expose the role catalogue and the permissions attached to each role.","operationId":"list_roles_api_v1_auth_roles_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"additionalProperties":{"items":{"type":"string"},"type":"array"},"type":"object","title":"Response List Roles Api V1 Auth Roles Get"}}}}}}},"/api/v1/users":{"get":{"tags":["User Management"],"summary":"List platform users","description":"Return a page of platform users.\n\nThe total matching the current filters is returned in the X-Total-Count\nheader so the client can paginate without a second endpoint.","operationId":"list_users_api_v1_users_get","security":[{"HTTPBearer":[]}],"parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","maximum":200,"minimum":1,"default":50,"title":"Limit"}},{"name":"offset","in":"query","required":false,"schema":{"type":"integer","minimum":0,"default":0,"title":"Offset"}},{"name":"role","in":"query","required":false,"schema":{"anyOf":[{"$ref":"#/components/schemas/Role"},{"type":"null"}],"description":"Filter by role","title":"Role"},"description":"Filter by role"},{"name":"is_active","in":"query","required":false,"schema":{"anyOf":[{"type":"boolean"},{"type":"null"}],"description":"Filter by account status","title":"Is Active"},"description":"Filter by account status"}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{"type":"array","items":{"$ref":"#/components/schemas/UserRead"},"title":"Response List Users Api V1 U